# ---------------------------------------------------------------------------
# VulnCascade environment
#
# The published build is a static demo and needs NONE of this — it ships with
# NEXT_PUBLIC_DEMO_MODE on and reads a bundled advisory snapshot.
# Copy this file to `.env` only when you want to run the real application.
# ---------------------------------------------------------------------------

# Set to "false" to build the real app: route handlers, Postgres, live OSV/NVD.
# Any other value (or unset) builds the offline demo.
NEXT_PUBLIC_DEMO_MODE=true

# --- Database (required when NEXT_PUBLIC_DEMO_MODE=false) ------------------
# Postgres 14+. Apply db/migrations/*.sql in filename order before first run.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vulncascade

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_DAYS=30

# --- Vulnerability sources --------------------------------------------------
# Google OSV needs no key and no account.
OSV_DISABLE_NETWORK=false
OSV_REQUEST_TIMEOUT_MS=10000
OSV_LOOKUP_CONCURRENCY=6

# NIST NVD enrichment is optional. Without a key you are limited to ~5 requests
# per 30s; a free key raises that to ~50. Request one at:
#   https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_DISABLE_NETWORK=false
NVD_REQUEST_TIMEOUT_MS=10000
NVD_RESULTS_PER_PAGE=20

# How long a CVE lookup stays warm in the cache table.
CVE_CACHE_TTL_HOURS=24

# Shared secret for POST/DELETE on /api/cache. Leave blank to disable the route.
CACHE_ADMIN_TOKEN=

# --- Optional: anonymous page-view analytics --------------------------------
# Leave blank to disable entirely. Any Postgres connection string works.
ANALYTICS_DATABASE_URL=
ANALYTICS_PROJECT_NAME=vulncascade
